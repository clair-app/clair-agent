# Build outputs. ./bin also holds the pinned tools `make tools` installs.
/bin/
/dist/
# CI's GOPATH, module and build caches (.gitlab-ci.yml). Untracked, they would stamp every
# CI build vcs.modified=true, and a release "+dirty".
/.go/
# The macos job's scratch space and log artifact (.gitlab-ci.yml); untracked too, for the same reason.
/.mac/
# A bare `go build ./cmd/clair` drops the binary here.
/clair
/clair.exe
coverage.out
*.test
*.prof

# IDE and OS.
.idea/
.vscode/
.DS_Store

# Personal per-machine Claude Code overrides — anything shared in .claude/ stays tracked.
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/worktrees/

# Private maintainer overlay: a separate, nested git repository holding release infrastructure,
# CI runner and signing-account details, and personal files — never part of the public repo.
.private/
