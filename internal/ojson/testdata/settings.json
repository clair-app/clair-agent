{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Read"
    ],
    "deny": []
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "say done && echo 'a > b'"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "printf \"it's %s\" \"$(cat | wc -c | tr -d ' ')\"",
    "padding": 0
  },
  "model": "opus",
  "env": {
    "FOO": "bär",
    "N": 1.0,
    "BIG": 12345678901234567890
  },
  "nested": {
    "empty": {},
    "list": [],
    "flag": false,
    "none": null
  }
}
