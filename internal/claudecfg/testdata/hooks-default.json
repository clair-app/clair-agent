{
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:7317/clair/v1/hook/decide?timeout=86400",
            "headers": {
              "Authorization": "Bearer t0k3n",
              "X-Clair-Host": "walter-laptop",
              "X-Clair-Entrypoint": "$CLAUDE_CODE_ENTRYPOINT"
            },
            "allowedEnvVars": [
              "CLAUDE_CODE_ENTRYPOINT"
            ],
            "timeout": 86400,
            "statusMessage": "Clair: also on your watch…"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:7317/clair/v1/hook/event",
            "headers": {
              "Authorization": "Bearer t0k3n",
              "X-Clair-Host": "walter-laptop"
            },
            "timeout": 2
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:7317/clair/v1/hook/event",
            "headers": {
              "Authorization": "Bearer t0k3n",
              "X-Clair-Host": "walter-laptop"
            },
            "timeout": 2
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:7317/clair/v1/hook/event",
            "headers": {
              "Authorization": "Bearer t0k3n",
              "X-Clair-Host": "walter-laptop"
            },
            "timeout": 2
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:7317/clair/v1/hook/event",
            "headers": {
              "Authorization": "Bearer t0k3n",
              "X-Clair-Host": "walter-laptop"
            },
            "timeout": 2
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:7317/clair/v1/hook/event",
            "headers": {
              "Authorization": "Bearer t0k3n",
              "X-Clair-Host": "walter-laptop"
            },
            "timeout": 2
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:7317/clair/v1/hook/event",
            "headers": {
              "Authorization": "Bearer t0k3n",
              "X-Clair-Host": "walter-laptop"
            },
            "timeout": 2
          }
        ]
      },
      {
        "matcher": "quota_auto_resume_fired|quota_auto_resume_stale|quota_auto_resume_disabled",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:7317/clair/v1/hook/event",
            "headers": {
              "Authorization": "Bearer t0k3n",
              "X-Clair-Host": "walter-laptop"
            },
            "timeout": 2
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:7317/clair/v1/hook/event",
            "headers": {
              "Authorization": "Bearer t0k3n",
              "X-Clair-Host": "walter-laptop"
            },
            "timeout": 2
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:7317/clair/v1/hook/event",
            "headers": {
              "Authorization": "Bearer t0k3n",
              "X-Clair-Host": "walter-laptop"
            },
            "timeout": 2
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/clair/clair hook-event /clair/v1/hook/event"
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:7317/clair/v1/hook/event",
            "headers": {
              "Authorization": "Bearer t0k3n",
              "X-Clair-Host": "walter-laptop"
            },
            "timeout": 2
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:7317/clair/v1/hook/event",
            "headers": {
              "Authorization": "Bearer t0k3n",
              "X-Clair-Host": "walter-laptop"
            },
            "timeout": 2
          }
        ]
      }
    ]
  }
}
