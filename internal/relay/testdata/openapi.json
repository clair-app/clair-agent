          "302": {
            "description": "To the agent repository's installer."
          },
          "404": {
            "description": "No installer is configured."
          }
        }
      }
    },
    "/robots.txt": {
      "get": {
        "tags": [
          "public"
        ],
        "operationId": "robots",
        "summary": "Disallow everything",
        "security": [],
        "responses": {
          "200": {
            "description": "text/plain.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
