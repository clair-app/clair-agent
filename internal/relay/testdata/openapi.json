  },
  "components": {
    "securitySchemes": {
      "ClairEd25519": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Every device request is signed with its Ed25519 key; there are no tokens and no sign-up. A device is registered by its first valid request.\n\n```text\nAuthorization: Clair-Ed25519 key=<b64url authPub>, ts=<unix seconds>, sig=<b64url signature>\nsig = Ed25519( METHOD \\n path-with-query \\n ts \\n sha256hex(body) )\n```\n\n`METHOD` upper-case; the path is the request target exactly as sent, query included; `sha256hex` is lowercase hex over the raw body bytes (an empty body hashes the empty string). `key` and `sig` are base64url without padding. `ts` must be within ±5 min of the relay's clock. The SSE `GET`s are signed the same way."
      },
      "CronBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "`CRON_SECRET`, sent by Vercel Cron."
      }
    },
    "schemas": {
      "Id": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{22}$",
        "description": "16 random bytes, base64url without padding."
      },
      "Envelope": {
        "type": "object",
        "properties": {
          "v": {
            "type": "number",
            "const": 1
          },
          "pair": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{22}$"
          },
          "id": {
            "type": "string",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
          },
          "dir": {
            "type": "string",
            "enum": [
              "h2p",
              "p2h"
            ]
          },
          "wake": {
            "type": "string",
            "enum": [
              "now",
              "soon",
              "no"
            ]
          },
          "ttlSec": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "ct": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{54,}$"
          }
        },
        "required": [
          "v",
          "pair",
          "id",
          "dir",
          "wake",
          "ttlSec",
          "ct"
        ],
        "additionalProperties": false,
        "description": "The relay's view of an envelope. `ct` is opaque ciphertext; `pair`, `id`, `dir` and `wake` are in its AAD and relayed untouched. `ttlSec` is clamped to 86400 s for `now` and `soon` and 3600 s for `no`."
      },
      "EnvelopeBatch": {
        "type": "object",
        "properties": {
          "envelopes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/Envelope"
            }
          }
        },
        "required": [
          "envelopes"
        ],
        "additionalProperties": false
      },
      "UploadReceipt": {
        "type": "object",
        "properties": {
          "accepted": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "cursor": {
                  "type": "integer"
                },
                "ttlSec": {
                  "type": "integer",
                  "description": "After clamping."
                }
              },
              "required": [
                "id",
                "cursor",
                "ttlSec"
              ]
            }
          },
          "duplicates": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Ids already in the mailbox; not stored again."
          }
        },
        "required": [
          "accepted",
          "duplicates"
        ]
      },
      "AckRequest": {
        "type": "object",
        "properties": {
          "cursor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "cursor"
        ],
        "additionalProperties": false
      },
      "PushTokenRequest": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "required": [
          "token"
        ],
        "additionalProperties": false
      },
      "CompletePairingRequest": {
        "type": "object",
        "properties": {
          "phonePub": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "pushToken": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "envelope": {
            "$ref": "#/components/schemas/Envelope"
          }
        },
        "required": [
          "phonePub",
          "envelope"
        ],
        "additionalProperties": false
      },
      "MintedPairing": {
        "type": "object",
        "properties": {
          "pairingId": {
            "$ref": "#/components/schemas/Id"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "pairingId",
          "expiresAt"
        ]
      },
      "CompletedPairing": {
        "type": "object",
        "properties": {
          "pairId": {
            "$ref": "#/components/schemas/Id"
          }
        },
        "required": [
          "pairId"
        ]
      },
      "PendingEvent": {
        "description": "`event: pending`, `id: 0`.",
        "type": "object",
        "properties": {
          "pairingId": {
            "$ref": "#/components/schemas/Id"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "pairingId",
          "expiresAt"
        ]
      },
      "CompletedEvent": {
        "description": "`event: completed`, `id: 1`. The phone's hello.",
        "type": "object",
        "properties": {
          "pairId": {
            "$ref": "#/components/schemas/Id"
          },
          "phonePub": {
            "type": "string"
          },
          "envelope": {
            "$ref": "#/components/schemas/Envelope"
          }
        },
        "required": [
          "pairId",
          "phonePub",
          "envelope"
        ]
      },
      "ExpiredEvent": {
        "description": "`event: expired`, `id: 1`.",
        "type": "object",
        "properties": {
          "pairingId": {
            "$ref": "#/components/schemas/Id"
          }
        },
        "required": [
          "pairingId"
        ]
      },
      "PresenceEvent": {
        "description": "`event: presence`, `id:` the current cursor.",
        "type": "object",
        "properties": {
          "peer": {
            "enum": [
              "host",
              "phone"
            ]
          },
          "state": {
            "enum": [
              "connected",
              "idle"
            ]
          },
          "at": {
            "type": "integer",
            "description": "Unix seconds."
          }
        },
        "required": [
          "peer",
          "state",
          "at"
        ]
      },
      "RevokedEvent": {
        "description": "`event: revoked`, `id:` the current cursor. Ends the stream.",
        "type": "object",
        "properties": {
          "pairId": {
            "$ref": "#/components/schemas/Id"
          }
        },
        "required": [
          "pairId"
        ]
      },
      "Health": {
        "type": "object",
        "properties": {
          "ok": {
            "const": true
          },
          "service": {
            "const": "clair-relay"
          },
          "commit": {
            "type": [
              "string",
              "null"
            ],
            "description": "The deployed commit, on Vercel."
          },
          "now": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "ok",
          "service",
          "commit",
          "now"
        ]
      },
      "SweepReport": {
        "type": "object",
        "properties": {
          "mailboxExpired": {
            "type": "integer"
          },
          "pairingsSwept": {
            "type": "integer"
          },
          "tombstonesSwept": {
            "type": "integer"
          },
          "heartbeatsCleared": {
            "type": "integer"
          },
          "devicesSwept": {
            "type": "integer"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "A stable code."
          },
          "issues": {
            "type": "array",
            "description": "On `invalid_body` and `invalid_envelope`.",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          },
          "retryAfterSeconds": {
            "type": "number",
            "description": "On `429`."
          }
        },
        "required": [
          "error"
        ]
      },
      "Unauthorized": {
        "type": "object",
        "properties": {
          "error": {
            "const": "unauthorized"
          },
          "reason": {
            "enum": [
              "malformed",
              "skew",
              "signature"
            ]
          },
          "serverTime": {
            "type": "integer",
            "description": "The relay's clock, unix seconds."
          }
        },
        "required": [
          "error",
          "reason",
          "serverTime"
        ]
      }
    }
  }
}
